# Environment Variables Template
# Copy this file to .env and fill in your values.
# DJANGO_SETTINGS_ENV selects which module core/settings/__init__.py loads:
#   local -> core/settings/local.py
#   prod  -> core/settings/prod.py

# Django Settings
DJANGO_SETTINGS_ENV=local
SECRET_KEY=your-secret-key-here
DEBUG=True
# Comma-separated, no spaces. Every hostname the site is served on must be listed
# here — prod.py derives CSRF_TRUSTED_ORIGINS from this, so bare and www variants
# both need an entry. In production also include the CapRover app subdomain, e.g.
# ALLOWED_HOSTS=dz-django.caprover.iqed.com.au,otec.ltd,www.otec.ltd,otec-au.com,www.otec-au.com
ALLOWED_HOSTS=localhost,127.0.0.1,otec.ltd,www.otec.ltd,otec-au.com,www.otec-au.com
RATELIMIT_ENABLE=False

# PostgreSQL Database Configuration
# DB_HOST/DB_PORT are what Django connects to. When Postgres runs via
# docker-compose, DB_PORT must match DB_HOST_PORT below (the published port),
# not the container's internal 5432.
# DB_HOST_PORT is the host port docker-compose publishes the db service on.
# Note 5432/5433 are the GoSupply stack's defaults — pick something else if
# you run both at once.
DB_HOST_PORT=5432
DB_NAME=dz
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Email Configuration (Brevo via Anymail)
# Set BREVO_API_KEY to send over Brevo's v3 HTTP API through Anymail — this is
# what enables per-message tags/metadata and delivery/bounce webhooks. Leave it
# empty and Django falls back to the plain SMTP settings below.
BREVO_API_KEY=
# Shared secret for Anymail's tracking webhook (?secret=... on the webhook URL)
ANYMAIL_WEBHOOK_SECRET=

# SMTP fallback — used only when BREVO_API_KEY is empty.
# Port 587 -> STARTTLS, port 465 -> implicit SSL (derived automatically from the port)
BREVO_SMTP=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_LOGIN=your-brevo-smtp-login
BREVO_PASSWORD=your-brevo-smtp-password
DEFAULT_FROM_EMAIL=info@otec-au.com
CONTACT_EMAIL=info@otec-au.com
SERVER_EMAIL=noreply@otec-au.com
