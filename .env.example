# Environment Variables Template
# Copy this file to .env and fill in your values.
# DJANGO_SETTINGS_ENV selects which module core/settings/__init__.py loads:
#   local -> core/settings/local.py
#   prod  -> core/settings/prod.py

# Django Settings
DJANGO_SETTINGS_ENV=local
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
RATELIMIT_ENABLE=False

# PostgreSQL Database Configuration
DB_NAME=dz
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Email Configuration (Brevo SMTP)
# Port 587 -> STARTTLS, port 465 -> implicit SSL (derived automatically from the port)
BREVO_SMTP=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_LOGIN=your-brevo-smtp-login
BREVO_PASSWORD=your-brevo-smtp-password
DEFAULT_FROM_EMAIL=info@otec-au.com
CONTACT_EMAIL=info@otec-au.com
SERVER_EMAIL=noreply@otec-au.com
